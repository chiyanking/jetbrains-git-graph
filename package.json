      {
        "command": "git-brains.context.columnDate",
        "title": "Date",
        "category": "GitLog",
        "enablement": "!gitBrainsDisabled_columnDate",
        "toggled": "gitBrainsChecked_columnDate"
      },
      {
        "command": "git-brains.context.columnHash",
        "title": "Hash",
        "category": "GitLog",
        "enablement": "!gitBrainsDisabled_columnHash",
        "toggled": "gitBrainsChecked_columnHash"
      }
    ],
    "menus": {
      "view/title": [],
      "scm/title": [
        {
          "command": "git-brains.openConflicts",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "git-brains.openMergeEditorFromSCM",
          "when": "scmProvider == git && scmResourceGroup == merge",
          "group": "inline@10"
        }
      ],
      "editor/context": [
        {
          "command": "git-brains.showFileHistory",
          "when": "editorTextFocus",
          "group": "git@1"
        },
        {
          "command": "git-brains.editSource",
          "when": "isInDiffEditor && resourceScheme != file",
          "group": "git@2"
        }
      ],
      "explorer/context": [
        {
          "command": "git-brains.showFileHistory",
          "when": "!explorerResourceIsFolder",
          "group": "git@1"
        }
      ],
      "commandPalette": [
        {
          "command": "git-brains.context.copyHash",
          "when": "false"
        },
