        "enablement": "!gitBrainsDisabled_cherryPickFile"
      },
      {
        "command": "git-brains.context.copyPath",
        "title": "Copy Path",
        "category": "GitLog",
        "enablement": "!gitBrainsDisabled_copyPath"
      },
      {
        "command": "git-brains.context.copyFileName",
