        "enablement": "!gitBrainsDisabled_resetMixed"
      },
      {
        "command": "git-brains.context.resetSoft",
        "title": "Reset to Here (Soft)",
        "category": "GitLog",
        "enablement": "!gitBrainsDisabled_resetSoft"
      },
      {
        "command": "git-brains.context.resetHard",
        "title": "Reset to Here (Hard)",
        "category": "GitLog",
        "enablement": "!gitBrainsDisabled_resetHard"
      },
      {
        "command": "git-brains.context.checkoutRevision",
