        "enablement": "!gitBrainsDisabled_showInLog"
      },
      {
        "command": "git-brains.context.dropCommit",
        "title": "Drop Commit…",
        "category": "GitLog",
        "enablement": "!gitBrainsDisabled_dropCommit"
      },
      {
        "command": "git-brains.context.showDiff",
        "title": "Show Diff",
        "category": "GitLog",
        "enablement": "!gitBrainsDisabled_showDiff"
      },
      {
        "command": "git-brains.context.editSource",
        "title": "Edit Source",
        "category": "GitLog",
        "enablement": "!gitBrainsDisabled_editSource"
      },
      {
        "command": "git-brains.context.repoVersion",
        "title": "Open Repository Version",
        "category": "GitLog",
        "enablement": "!gitBrainsDisabled_repoVersion"
      },
      {
        "command": "git-brains.context.revertFile",
        "title": "Revert Selected Changes",
