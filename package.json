{
  "name": "idea-like-git-graph",
  "displayName": "JetBrains Git - IntelliJ IDEA Git Graph, Commit & Shelf for VS Code",
  "publisher": "autemj",
  "description": "Bring IntelliJ IDEA / JetBrains Git experience to VS Code & Cursor: Git graph visualization, IDEA-style commit panel with shelf/stash, branch management, cherry-pick, rebase, merge, 3-way merge editor, and context menus. The best JetBrains Git alternative for Visual Studio Code.",
  "version": "0.4.19",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/aotemj/jetbrains-git-graph"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "intellij",
    "jetbrains",
    "idea",
    "git graph",
    "commit",
    "shelf",
    "stash",
    "branch",
    "merge",
    "cherry-pick",
    "rebase",
    "git log",
    "context menu",
    "diff",
    "3-way merge",
    "webstorm",
    "pycharm",
    "goland",
    "rider"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "git-brains-panel",
          "title": "GitLog",
          "icon": "$(git-branch)"
        }
      ],
      "activitybar": [
        {
          "id": "git-brains-commit",
          "title": "Source Control",
          "icon": "images/source-control.svg"
        }
      ]
    },
    "views": {
      "git-brains-panel": [
        {
          "type": "webview",
          "id": "git-brains.gitLog",
          "name": "Git Log"
        }
      ],
      "git-brains-commit": [
        {
          "id": "git-brains.repositories",
          "name": "Repositories",
          "visibility": "visible"
        },
        {
          "type": "webview",
          "id": "git-brains.commitPanel",
          "name": "Local Changes",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "git-brains.refreshLog",
        "title": "Refresh Git Log",
        "icon": "$(refresh)",
        "category": "GitLog"
      },
      {
        "command": "git-brains.selectRepository",
        "title": "Select Repository",
        "category": "GitLog"
      },
      {
        "command": "git-brains.openMergeEditor",
        "title": "Open Merge Editor",
        "category": "GitLog"
      },
      {
        "command": "git-brains.openConflicts",
        "title": "Conflicts",
        "icon": "$(git-merge)",
        "category": "GitLog"
      },
      {
        "command": "git-brains.openMergeEditorFromSCM",
        "title": "Open in GitLog Merge Editor",
        "icon": "$(git-merge)",
        "category": "GitLog"
      },
      {
        "command": "git-brains.showFileHistory",
        "title": "(GitLog) Show File History",
        "icon": "$(history)",
        "category": "GitLog"
      },
      {
        "command": "git-brains.nextDiff",
        "title": "Next File Diff",
        "icon": "$(arrow-down)",
        "category": "GitLog"
      },
      {
        "command": "git-brains.prevDiff",
        "title": "Previous File Diff",
        "icon": "$(arrow-up)",
        "category": "GitLog"
      },
      {
        "command": "git-brains.commitPanel.refresh",
        "title": "Refresh Changes",
        "icon": "$(refresh)",
        "category": "GitLog"
      },
      {
        "command": "git-brains.commitPanel.commit",
        "title": "Commit",
        "icon": "$(check)",
        "category": "GitLog"
      },
      {
        "command": "git-brains.commitPanel.commitAndPush",
        "title": "Commit and Push",
        "icon": "$(cloud-upload)",
        "category": "GitLog"
      },
      {
        "command": "git-brains.commitPanel.shelve",
        "title": "Shelve Changes",
        "icon": "$(archive)",
        "category": "GitLog"
      },
      {
        "command": "git-brains.commitPanel.unshelve",
        "title": "Unshelve Changes",
        "icon": "$(package)",
        "category": "GitLog"
      },
      {
        "command": "git-brains.openPushPanel",
        "title": "Push...",
        "icon": "$(cloud-upload)",
        "category": "GitLog"
      },
      {
        "command": "git-brains.editSource",
        "title": "(GitLog) Edit Source",
        "icon": "$(go-to-file)",
        "category": "GitLog"
      },
      {
        "command": "git-brains.context.copyHash",
        "title": "Copy Revision Number",
        "category": "GitLog",
        "enablement": "!gitBrainsDisabled_copyHash"
      },
      {
        "command": "git-brains.context.cherryPick",
        "title": "Cherry-Pick",
        "category": "GitLog",
        "enablement": "!gitBrainsDisabled_cherryPick"
      },
      {
        "command": "git-brains.context.squash",
