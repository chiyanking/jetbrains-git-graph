      "webview/context": [
        {
          "group": "gitBrains_01@1",
          "command": "git-brains.context.copyHash",
          "when": "webviewId == git-brains.gitLog && webviewSection == commit && gitBrainsMenu_copyHash"
        },
        {
          "group": "gitBrains_02@1",
          "command": "git-brains.context.cherryPick",
          "when": "webviewId == git-brains.gitLog && webviewSection == commit && gitBrainsMenu_cherryPick"
        },
        {
          "group": "gitBrains_02@2",
          "command": "git-brains.context.squash",
          "when": "webviewId == git-brains.gitLog && webviewSection == commit && gitBrainsMenu_squash"
        },
        {
          "group": "gitBrains_02@3",
          "command": "git-brains.context.editMessage",
          "when": "webviewId == git-brains.gitLog && webviewSection == commit && gitBrainsMenu_editMessage"
        },
        {
          "group": "gitBrains_03@1",
          "command": "git-brains.context.resetMixed",
          "when": "webviewId == git-brains.gitLog && webviewSection == commit && gitBrainsMenu_resetMixed"
        },
        {
          "group": "gitBrains_03@2",
          "command": "git-brains.context.resetSoft",
          "when": "webviewId == git-brains.gitLog && webviewSection == commit && gitBrainsMenu_resetSoft"
        },
        {
          "group": "gitBrains_03@3",
          "command": "git-brains.context.resetHard",
          "when": "webviewId == git-brains.gitLog && webviewSection == commit && gitBrainsMenu_resetHard"
        },
        {
          "group": "gitBrains_04@1",
          "command": "git-brains.context.checkoutRevision",
          "when": "webviewId == git-brains.gitLog && webviewSection == commit && gitBrainsMenu_checkoutRevision"
        },
        {
          "group": "gitBrains_04@2",
          "command": "git-brains.context.revertCommit",
          "when": "webviewId == git-brains.gitLog && webviewSection == commit && gitBrainsMenu_revertCommit"
        },
        {
          "group": "gitBrains_05@1",
          "command": "git-brains.context.newBranch",
          "when": "webviewId == git-brains.gitLog && webviewSection == commit && gitBrainsMenu_newBranch"
        },
        {
          "group": "gitBrains_05@2",
          "command": "git-brains.context.newTag",
          "when": "webviewId == git-brains.gitLog && webviewSection == commit && gitBrainsMenu_newTag"
        },
        {
          "group": "gitBrains_06@1",
          "command": "git-brains.context.showInLog",
          "when": "webviewId == git-brains.gitLog && webviewSection == commit && gitBrainsMenu_showInLog"
        },
        {
          "group": "gitBrains_07@1",
          "command": "git-brains.context.dropCommit",
          "when": "webviewId == git-brains.gitLog && webviewSection == commit && gitBrainsMenu_dropCommit"
        },
        {
          "group": "gitBrains_01@1",
          "command": "git-brains.context.showDiff",
          "when": "webviewId == git-brains.gitLog && webviewSection == logFile && gitBrainsMenu_showDiff"
        },
        {
          "group": "gitBrains_01@2",
          "command": "git-brains.context.editSource",
          "when": "webviewId == git-brains.gitLog && webviewSection == logFile && gitBrainsMenu_editSource"
        },
        {
          "group": "gitBrains_01@3",
          "command": "git-brains.context.repoVersion",
          "when": "webviewId == git-brains.gitLog && webviewSection == logFile && gitBrainsMenu_repoVersion"
        },
        {
          "group": "gitBrains_02@1",
          "command": "git-brains.context.revertFile",
          "when": "webviewId == git-brains.gitLog && webviewSection == logFile && gitBrainsMenu_revertFile"
        },
        {
          "group": "gitBrains_02@2",
          "command": "git-brains.context.cherryPickFile",
          "when": "webviewId == git-brains.gitLog && webviewSection == logFile && gitBrainsMenu_cherryPickFile"
        },
        {
          "group": "gitBrains_03@1",
          "command": "git-brains.context.copyPath",
          "when": "webviewId == git-brains.gitLog && webviewSection == logFile && gitBrainsMenu_copyPath"
        },
        {
          "group": "gitBrains_03@2",
          "command": "git-brains.context.copyFileName",
          "when": "webviewId == git-brains.gitLog && webviewSection == logFile && gitBrainsMenu_copyFileName"
        },
        {
          "group": "gitBrains_04@1",
          "command": "git-brains.context.history",
          "when": "webviewId == git-brains.gitLog && webviewSection == logFile && gitBrainsMenu_history"
        },
        {
